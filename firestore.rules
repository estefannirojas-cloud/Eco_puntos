rules_version = '2';

// Reglas de seguridad de EcoPuntos.
// Deciden quién puede leer o escribir cada dato, aunque alguien intente saltarse la app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function validText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    // Un documento por persona, con el mismo id que su cuenta.
    match /usuarios/{uid} {
      // Cada persona ve su propio perfil; el administrador ve todos.
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Al registrarse, solo puede crear SU perfil y siempre como "cliente".
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'correo', 'celular', 'ciudad', 'rol', 'creadoEn'])
        && request.resource.data.rol == 'cliente'
        && request.resource.data.correo == request.auth.token.email
        && validText(request.resource.data.nombre, 100) && request.resource.data.nombre.size() > 0
        && validText(request.resource.data.celular, 20)
        && validText(request.resource.data.ciudad, 60)
        && request.resource.data.creadoEn == request.time;

      // Puede cambiar sus datos personales, pero nunca su rol ni su correo.
      // El administrador sí puede cambiar el rol (por ejemplo, nombrar gestores).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'celular', 'ciudad'])
          && validText(request.resource.data.nombre, 100) && request.resource.data.nombre.size() > 0
          && validText(request.resource.data.celular, 20)
          && validText(request.resource.data.ciudad, 60))
        || (isAdmin() && request.resource.data.rol in ['cliente', 'gestor', 'admin'])
      );

      allow delete: if isAdmin();
    }

    // Todo lo demás está cerrado hasta que lo definamos.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
