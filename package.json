    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.35.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
